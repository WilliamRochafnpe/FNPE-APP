# Copie para .env e preencha com Project URL e anon key (JWT eyJ... ou sb_publishable_...)
# Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://SEU_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Produção (Netlify): Site configuration → Environment variables
# Use os MESMOS nomes (VITE_*). Depois: Deploys → Trigger deploy → Clear cache and deploy.
# Sem essas variáveis no BUILD, o site fica em modo local e o OTP não é enviado por e-mail.
